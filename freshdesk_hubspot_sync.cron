# assigns owner to Shabib, fills POC details, links contact, and links deal(s).
0 */4 * * * cd /Users/shishirraj/freshdesk-tool && /usr/bin/python3 freshdesk_hubspot_sync.py >> /Users/shishirraj/freshdesk-tool/freshdesk_hubspot_sync.log 2>&1
